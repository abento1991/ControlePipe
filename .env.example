# PostgreSQL connection (local, Supabase, Neon, RDS...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leto_pipeline?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# URL pública da aplicação. Em produção (Railway/Render) pode ficar de fora: o container usa o domínio público.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Single strong team password for the login screen (recommended for the first deploy). Generate: openssl rand -base64 24
APP_PASSWORD=""

# Initial admin password used by `npm run db:seed` for the four team users (change after first login)
SEED_DEFAULT_PASSWORD="change-me-on-first-login"

# Path to the historical workbook used by `npm run import:pipeline`
PIPELINE_WORKBOOK="./data/Acompanhamento do Pipe_20260817.xlsx"

# Backup automático por e-mail (opcional). Destinatários separados por vírgula; horário de São Paulo.
BACKUP_EMAIL_TO=""
BACKUP_FREQUENCY="weekly"   # weekly | daily
BACKUP_DAY="1"              # 0 = domingo … 6 = sábado (só para weekly)
BACKUP_HOUR="6"             # 0–23
# Envio: SMTP de qualquer caixa (Microsoft 365 / Google Workspace com senha de app) …
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Leto Pipeline <pipe@letocapital.com.br>"
# … ou a API do Resend (https://resend.com), sem SMTP
RESEND_API_KEY=""
